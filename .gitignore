│ │ └── middleware/ # CORS, logging
│ ├── scripts/ # DB seeding, ETL
│ ├── tests/ # Pytest tests
│ └── data/ # SQLite + FAISS index
│
├── frontend/ # React frontend
│ └── src/
│ ├── api/ # Axios clients
│ ├── components/ # Reusable UI
│ ├── pages/ # Route pages
